# ============================================================================
# Client (browser) configuration — Vite only exposes VITE_* variables
# ============================================================================
# From Supabase -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_project_url_here

# Use the public key for the browser. Depending on your dashboard version this
# is labelled either the "anon" key or the newer "publishable" key
# (sb_publishable_...). Set ONE of the following:
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ============================================================================
# Server-side secrets — DO NOT put these in this file for production
# ----------------------------------------------------------------------------
# These belong to the Edge Functions and must never reach the browser bundle.
# Set them with the Supabase CLI instead:
#
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set NOTIFY_EMAIL_FROM="Uy-Laurio Law Office <noreply@yourdomain.ph>"
#   supabase secrets set SEMAPHORE_API_KEY=...
#   supabase secrets set SEMAPHORE_SENDER=UYLAURIO
#   supabase secrets set CRON_SECRET=...
#   supabase secrets set FUNCTION_ALLOWED_ORIGIN=https://your-site.example
#
# Alternatively, for Twilio instead of Semaphore:
#   supabase secrets set TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_FROM_NUMBER=+63...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Edge Function runtime — never copy the service role key into a VITE_ variable.
# ============================================================================
